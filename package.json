{
  "name": "lenqclaw",
  "version": "0.0.1",
  "private": true,
  "description": "Zalo community-care agent (lenqclaw) - monorepo root",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run build -w @lenqclaw/core && npm run typecheck --workspaces --if-present",
    "build": "npm run build -w @lenqclaw/core && npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:db": "npm run db:migrate && npm run db:seed && node --import tsx scripts/seed-sim-for-test.mjs && npm run test:db -w @lenqclaw/core && npm run test:db -w @lenqclaw/web && npm run test:db -w @lenqclaw/zalo-worker --if-present",
    "db:migrate": "tsx packages/core/src/db/migrate.ts",
    "db:seed": "tsx packages/core/src/db/seed.ts",
    "db:seed:sim": "tsx packages/core/src/db/seed-sim.ts",
    "create-admin": "tsx packages/core/src/scripts/create-admin.ts",
    "core:run": "tsx packages/core/src/runner/inbound-runner.ts",
    "zalo:worker": "tsx apps/zalo-worker/src/main.ts",
    "dev:link-zalo": "tsx packages/core/src/dev/link-zalo.ts",
    "check:adapter-boundary": "node scripts/check_adapter_boundary.mjs",
    "check:agent-tools": "node scripts/check_agent_tools.mjs",
    "eval:golden": "tsx scripts/eval_golden.mjs",
    "gate": "node scripts/gate.mjs"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
