flowchart TD
  classDef io fill:#e3f2fd,stroke:#1565c0,color:#0d2b4e
  classDef model fill:#fff3e0,stroke:#ef6c00,color:#4e2600
  classDef out fill:#e8f5e9,stroke:#2e7d32,color:#103b14
  classDef pure fill:#f3e5f5,stroke:#6a1b9a,color:#2e0b45
  classDef plain fill:#ffffff,stroke:#78909c,color:#263238
  classDef stop fill:#eceff1,stroke:#90a4ae,color:#455a64

  Z["📱 Zalo<br/>tin nhóm · DM · sự kiện nhóm"]:::io --> W["Worker Zalo (zca-js)"]:::io
  W --> IE[("Hàng đợi vào · inbound_events")]:::io
  T["⏱ Đồng hồ 10 giây — KHÔNG gọi model<br/>gom tin ambient · chào người mới<br/>câu hỏi bỏ trống · lịch tự động"]:::io --> IE
  IE --> R{"routeEvent<br/>loại sự kiện?"}:::pure

  subgraph P["① pipelineGraph — mỗi tin / sự kiện chạy qua đúng 1 lần"]
    R -->|tin nhóm| ING["ingest<br/>lưu vào đệm nhóm (≤ 200 tin)"]:::plain
    R -->|sự kiện nhóm| GEV["group_event<br/>vào · rời · lên phó · xin vào"]:::out
    R -->|"system (từ đồng hồ)"| SYS["system_event<br/>chọn loại lượt"]:::out
    R -->|DM| DMI["dm_intake<br/>xác định vai · hội thoại"]:::out
    ING -->|còn lại| TRI["triage — model nhỏ<br/>spam? câu hỏi? khách tiềm năng?"]:::model
    DMI -->|tin chữ| TRI
    TRI -->|nhóm| MOD["moderate — kiểm duyệt<br/>lưới cứng + triage<br/>⇒ cảnh cáo · xoá tin · thẻ duyệt kick"]:::out
    MOD -->|còn lại| GATE{"gate — có cần nói không?<br/>hàm thuần · 28 ca test"}:::pure
    GATE -->|ambient| DEF["defer<br/>chờ gom 20 giây"]:::plain
    GATE -->|"mention · quote · gọi tên · lệnh"| TURN[["⑧ LƯỢT AGENT"]]:::plain
    TRI -->|DM| TURN
    SYS -->|"gom ambient · chào · câu hỏi bỏ trống<br/>duyệt vào nhóm · lịch"| TURN
    STOP1(["⏹ dừng — không làm gì thêm"]):::stop
    ING -.->|"nhóm tắt / lạ · tin của chính bot"| STOP1
    MOD -.->|tin đã bị xoá| STOP1
    GATE -.->|không ai gọi bot| STOP1
    DMI -.->|"chủ đang tự trả lời · sticker/ảnh"| STOP1
    SYS -.->|"kết quả thẻ duyệt · sự kiện giả mạo"| STOP1
    GEV --> STOP1
    DEF --> STOP1
  end

  subgraph TG["② turnGraph — một lượt agent · tối đa 8 vòng tool"]
    PREP["prepare<br/>persona · ≤ 5 lượt gần nhất · tool theo vai"]:::plain
    AG["agent — gọi model chính"]:::model
    TL["tools<br/>luật cứng nằm TRONG tool"]:::out
    NU["nudge<br/>nhắc đúng 1 lần"]:::plain
    DEL["deliver — host tự gửi<br/>câu trả lời · câu dự phòng · cho vào nhóm"]:::out
    TR["trace<br/>ghi đúng 1 dòng nhật ký lượt"]:::plain
    PREP -->|ok| AG
    AG -->|muốn dùng tool| TL
    TL -->|vòng + 1| AG
    AG -->|bị gọi mà chưa trả lời| NU
    NU --> AG
    AG -->|"xong · model sập · từ chối · chạm trần"| DEL
    PREP -.->|persona hỏng| DEL
    DEL --> TR
  end
  TURN ==>|gọi| PREP

  OUT[("📤 outbox — đường ra DUY NHẤT")]:::io
  TL --> OUT
  DEL --> OUT
  NOTE["mọi ô xanh lá đều chỉ ghi vào outbox,<br/>không ô nào gửi thẳng ra Zalo"]:::out -.- OUT
  OUT -->|"pacer: ≤ 20 tin/giờ/nhóm · cách ≥ 9 giây"| W

  subgraph LG["Chú giải màu"]
    L1["gọi model"]:::model
    L2["ghi outbox: gửi tin / hành động"]:::out
    L3["hàm thuần: không DB, không model"]:::pure
    L4["vào / ra hệ thống"]:::io
  end
