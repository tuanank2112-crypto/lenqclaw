# Sao chep thanh .env va dien gia tri that. KHONG commit .env.
# POSTGRES_USER/PASSWORD/DB: Docker Compose tu doc file .env nay de dien
# ${POSTGRES_...:?} trong compose.yaml (mat khau KHONG ghi cung trong
# compose.yaml, khac gia tri that voi gia tri dev ben duoi truoc khi dung
# that/VPS).
POSTGRES_USER=lenqclaw
POSTGRES_PASSWORD=lenqclaw
POSTGRES_DB=lenqclaw
DATABASE_URL=postgres://lenqclaw:lenqclaw@127.0.0.1:15432/lenqclaw
SESSION_SECRET=change-me-32-bytes-minimum-secret-value
ZALO_SESSION_KEY=change-me-32-byte-key-hex-or-base64
STORAGE_KEY=change-me-32-byte-key-hex-or-base64

# --- Tai khoan Zalo (01-CONTRACTS §10, D12): chi `community` ---------------
ZALO_ACCOUNTS=community

# --- Model (01-CONTRACTS §2.1) ----------------------------------------------
# MODEL_PROVIDER=gemini la MAC DINH (co the doi thanh "anthropic", "openrouter"
# hoac "vyce" — OpenRouter/Vyce la duong tam/du phong, doi mac dinh can nguoi
# chot). MODEL_DEFAULT rong => tu dong 'gemini-3.6-flash' (gemini) /
# 'claude-opus-5' (anthropic) / 'google/gemini-3.6-flash' (openrouter) /
# 'deepseek-v4-flash' (vyce). GEMINI_API_KEY/ANTHROPIC_API_KEY/
# OPENROUTER_API_KEY/VYCE_API_KEY CHI can dien key cua provider dang dung.
# MODEL_FALLBACKS rong => mac dinh 'gemini-3-flash-preview,gemini-3.5-flash-lite'
# cho gemini, 'google/gemini-3-flash-preview' cho openrouter, RONG cho
# anthropic/vyce. Vyce CHI chay khi DATA_MODE=sim (proxy ben thu ba khong cam
# ket khong luu du lieu).
MODEL_PROVIDER=gemini
GEMINI_API_KEY=changeme-gemini-key
ANTHROPIC_API_KEY=sk-ant-changeme
# OpenRouter: https://openrouter.ai/api/v1 mac dinh khi rong.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
# Vyce AI: https://vyceai.com/v1 mac dinh khi rong.
VYCE_API_KEY=
VYCE_BASE_URL=
MODEL_DEFAULT=
MODEL_FALLBACKS=
# Hai route: `community` (luot agent) va `triage` (hieu y, khong roi ve MODEL_DEFAULT).
# Rong => theo provider ('gemini-3.5-flash-lite' / 'claude-haiku-4-5' cho triage).
MODEL_COMMUNITY=
MODEL_TRIAGE=
# Qua han goi triage (ms) => coi nhu loi, khong retry.
TRIAGE_TIMEOUT_MS=4000

# --- Embedding (SPEC-P04): gemini-embedding-001, 1024 chieu khop cot vector(1024) ---
EMBED_PROVIDER=gemini
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=1024

# --- Dem nhom (BB-11) ---------------------------------------------------------
GROUP_BUFFER_MAX=200
GROUP_BUFFER_RETENTION_DAYS=7

# --- Ngu canh luot nhom & ambient (SPEC-P03 §4) ---------------------------------
AMBIENT_DEBOUNCE_SEC=20
AMBIENT_CONTEXT_MESSAGES=40
MENTION_CONTEXT_MESSAGES=25

# --- Cau hoi bo trong (SPEC-P04 §5) ------------------------------------------------
UNANSWERED_AFTER_MIN=10
UNANSWERED_MAX_AGE_HOURS=6
UNANSWERED_MAX_PER_TICK=3

# --- Chao thanh vien moi (SPEC-P05 §7) ------------------------------------------------
WELCOME_DEBOUNCE_SEC=120
WELCOME_WINDOW_MIN=15

# --- Kiem duyet & thang canh cao (SPEC-P05 §3–§4) -----------------------------------
MOD_SCAM_MIN=0.85
MOD_SPAM_MIN=0.75
MOD_LADDER_HALF_LIFE_HOURS=168
MOD_WARN_PER_HOUR=10

# --- The duyet & yeu cau vao nhom ---------------------------------------------------
APPROVAL_TTL_HOURS=24
JOIN_REQUEST_TTL_HOURS=48

# --- Pacer (BB-08): tai khoan + nhom -------------------------------------------------
PACER_MAX_PER_MINUTE=10
PACER_MAX_CHARS=1800
PACER_GROUP_GAP_MS=8000
PACER_GROUP_JITTER_MS=3000
GROUP_TEXT_TTL_MIN=30
PACER_ACTIONS_PER_TICK=3

# --- Dong ho & lich (SPEC-P07) -------------------------------------------------------
TIMER_INTERVAL_MS=10000
DAILY_REPORT_HOUR=20
WEEKLY_SUMMARY_DOW=0
WEEKLY_SUMMARY_HOUR=19

# --- Tri thuc, tri nho, lead ---------------------------------------------------------
KB_TOP_K=8
MEMORY_HALF_LIFE_DAYS=30
LEAD_SCORE_HANDOFF=60

# --- Vong lap tool & ngu canh DM (SPEC-P03 §5–§6, D22) ----------------------------------
MAX_TOOL_ROUNDS=8
DM_HISTORY_TURNS=5
MESSAGES_RETENTION_DAYS=30
# So phut nguoi that tiep quan sau handoff_to_owner.
HUMAN_TAKEOVER_MIN=60

# --- Che do chay ---------------------------------------------------------------------
DATA_MODE=sim
TRANSPORT=sim

# --- Canh bao van hanh ---------------------------------------------------------------
ALERT_EMAIL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
