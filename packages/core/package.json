{
  "name": "@lenqclaw/core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --exclude \"**/*.db.test.ts\"",
    "test:db": "tsx scripts/require-database-url.ts && vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@langchain/core": "1.2.14",
    "@langchain/langgraph": "1.4.18",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "@types/node": "^22.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
