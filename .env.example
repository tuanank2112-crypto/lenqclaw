# Sao chep thanh .env va dien gia tri that. KHONG commit .env.
# POSTGRES_USER/PASSWORD/DB: Docker Compose tu doc file .env nay de dien
# ${POSTGRES_...:?} trong compose.yaml (D9 — mat khau KHONG ghi cung trong
# compose.yaml, khac gia tri that voi gia tri dev ben duoi truoc khi dung
# that/VPS).
POSTGRES_USER=lenqclaw
POSTGRES_PASSWORD=lenqclaw
POSTGRES_DB=lenqclaw
DATABASE_URL=postgres://lenqclaw:lenqclaw@127.0.0.1:55432/lenqclaw
SESSION_SECRET=change-me-32-bytes-minimum-secret-value
ZALO_SESSION_KEY=change-me-32-byte-key-hex-or-base64
STORAGE_KEY=change-me-32-byte-key-hex-or-base64
# 01-CONTRACTS §2b (Đ18/Đ19) / §2c (Đ24) / §2d (Đ25): MODEL_PROVIDER=gemini
# la MAC DINH (co the doi thanh "anthropic", "openrouter" hoac "vyce" —
# OpenRouter/Vyce la duong tam/du phong, doi mac dinh can nguoi chot).
# MODEL_DEFAULT rong => tu dong 'gemini-3.6-flash' (gemini) /
# 'claude-opus-5' (anthropic) / 'google/gemini-3.6-flash' (openrouter) /
# 'deepseek-v4-flash' (vyce). GEMINI_API_KEY/ANTHROPIC_API_KEY/
# OPENROUTER_API_KEY/VYCE_API_KEY CHI can dien key cua provider dang dung.
# MODEL_FALLBACKS rong => mac dinh 'gemini-3-flash-preview,gemini-3.5-flash-lite'
# cho gemini, 'google/gemini-3-flash-preview' cho openrouter, RONG cho
# anthropic/vyce. Vyce (§2d) CHI chay khi DATA_MODE=sim (proxy ben thu ba
# khong cam ket khong luu du lieu cu dan).
MODEL_PROVIDER=gemini
GEMINI_API_KEY=changeme-gemini-key
ANTHROPIC_API_KEY=sk-ant-changeme
# OpenRouter (Đ24): https://openrouter.ai/api/v1 mac dinh khi rong.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
# Vyce AI (Đ25): https://vyceai.com/v1 mac dinh khi rong; model mac dinh
# 'deepseek-v4-flash' (triage cung vay — khong co ban re hon rieng).
VYCE_API_KEY=
VYCE_BASE_URL=
MODEL_DEFAULT=
MODEL_FALLBACKS=
MODEL_DIAGNOSE=
MODEL_RESPONSIBILITY=
MODEL_ACCEPTANCE=
MODEL_VENDOR_PARSE=
MODEL_COMPOSE=
# SPEC-P03 §11.10 (Đ21): route 'triage' rieng, KHONG roi ve MODEL_DEFAULT.
# Rong => 'gemini-3.5-flash-lite' (gemini) / 'claude-haiku-4-5' (anthropic).
MODEL_TRIAGE=
# Qua han goi triage (ms) => coi nhu loi, khong retry (do tre quan trong hon).
TRIAGE_TIMEOUT_MS=4000
# SPEC-P03 §11.1: nguong bat khan cap cua lop 2 (hieu y model), [0,1].
TRIAGE_EMERGENCY_MIN=0.5
# SPEC-P03 §11.6 (N3): so phut nguoi that tiep quan sau handoff_to_staff.
HUMAN_TAKEOVER_MIN=60
# So hotline BQL hien trong EMERGENCY_REPLY (gia tri gia, dien that truoc VPS).
BQL_HOTLINE=1900-0000
PACER_MIN_INTERVAL_MS=1500
PACER_MAX_PER_MINUTE=20
DATA_MODE=sim
TRANSPORT=sim
# --- SPEC-P05-Dispatch.md §10.2.3 (Đ27) ------------------------------------
HOLD_MINUTES=10
# L3 (SPEC-P05 §10.0): ten chot la DISPATCH_TIMEOUT_MIN, mac dinh 45 (khong
# phai 30 nhu ban cu — mot ten, mot so).
DISPATCH_TIMEOUT_MIN=45
ACCESS_REMIND_MIN=30
QUOTE_OVER_BAND_PCT=30
QUOTE_CONSENT_MIN=30
MAX_HOLD_REPUBLISH=2
NO_SHOW_BLOCK_THRESHOLD=3
NO_SHOW_WINDOW_DAYS=30
NO_SHOW_BLOCK_DAYS=7
ACCESS_PASS_BEFORE_MIN=30
ACCESS_PASS_AFTER_MIN=120
PUBLISH_FALLBACK_MIN=2
REQUEST_ACCESS_FALLBACK_MIN=2
DISPATCH_REEMIT_MIN=5
TIMER_INTERVAL_MS=10000
# SPEC-P05 §10.4.2/§10.4.4: nguong intent_confidence de claim_job/
# confirm_assignment/decline_hold coi la co bang chung y dinh tu lop hieu y
# (agent/vendor-triage.ts, P05-C) — dat 1.01 (khong bao gio dat duoc) de TAT
# lop hieu y, chi con danh sach cum an toan tat dinh (§10.4.2) quyet dinh.
VENDOR_INTENT_MIN=0.6
# Đ14 — GIA (🖐 nguoi chot, SPEC-P05 §10.16 Q1): tham so phi slot thang.
FREE_TRIAL_DAYS=30
SLOT_FEE_MONTHLY=300000
SLOT_MIN_JOBS_PER_VENDOR=8
BQL_SHARE_PCT=10
SLOT_PERIOD_DAYS=30
SLOT_REMIND_DAYS=3
WAITLIST_INVITE_HOURS=48
ALERT_EMAIL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
